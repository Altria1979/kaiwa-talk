# Kaiwa Talk：本地复制为 .env.local 调整模型；云端在 Vercel 项目设置填写。
# 本地端口通过命令设置：KAIWA_TALK_WEB_PORT=13000 pnpm dev（兼容 KAIWA_LAB_WEB_PORT / KOHARU_WEB_PORT）。
# 百炼 API Key 和接入域名只能在网页「练习设置」中配置，不使用服务器环境变量兜底。
# 数据库、Blob 和浏览器身份签名密钥仍由服务器环境变量配置；密钥不得添加 NEXT_PUBLIC_ 前缀。
BAILIAN_CHAT_MODEL=qwen3.8-flash
# 语音输入固定为日语 ja；中文求助请使用文字输入。
BAILIAN_ASR_MODEL=fun-asr-realtime
BAILIAN_TTS_MODEL=qwen3-tts-flash-realtime

# Vercel 专用。不要在普通 pnpm dev 环境启用；完整说明见 docs/vercel-deployment.md。
# 兼容旧 KAIWA_LAB_*、VIRTUALMAID_* 及其 NEXT_PUBLIC_ 配置；同名配置以 KAIWA_TALK 前缀优先。
# KAIWA_TALK_DEPLOYMENT=vercel
# KAIWA_TALK_PUBLIC_ORIGIN=https://your-project.vercel.app
# PORT=8080
# 至少 24 个字符的随机签名密钥，仅供服务器使用；访客无需登录。
# 修改后已有浏览器身份失效，不应定期轮换。
# KAIWA_TALK_BROWSER_SECRET=
# 从 Vercel Marketplace 的 Turso 集成获取，两项都必填。
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# 必须使用 private Blob store 的 token。
# BLOB_READ_WRITE_TOKEN=
# 仅在 localhost 测试同域云端布局时设置；线上域名自动使用同域地址。
# NEXT_PUBLIC_KAIWA_TALK_SAME_ORIGIN=1
